---
import { links } from '../site.config';
interface Props { title: string; body: string; button?: string }
const { title, body, button = 'Book a walkthrough' } = Astro.props;
const ext = links.bookExternal ? { target: '_blank', rel: 'noopener' } : {};
---
<section id="contact" class="bg-red">
  <div class="container cta">
    <h2 class="h1 title">{title}</h2>
    <p class="body">{body}</p>
    <div class="actions">
      <a href={links.book} class="btn btn-white" {...ext}>{button}</a>
    </div>
    <p class="direct">Or reach us directly</p>
    <div class="direct-links">
      <a href={links.whatsapp} class="btn btn-outline-white" target={links.whatsapp.startsWith('http') ? '_blank' : undefined} rel="noopener">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 20.5l1.6-5.4A8.4 8.4 0 1 1 21 11.5z" /></svg>
        WhatsApp us
      </a>
      <a href={links.call} class="btn btn-outline-white">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" /></svg>
        Call us
      </a>
      <a href={links.email} class="btn btn-outline-white">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="M22 6l-10 7L2 6" /></svg>
        Email us
      </a>
    </div>
  </div>
</section>

<style>
  .cta { padding-block: clamp(72px, 9vw, 136px); }
  .title { max-width: 1000px; font-size: clamp(36px, 5.6vw, 84px); line-height: 1; }
  .body { margin-top: 28px; max-width: 600px; font-size: 19px; }
  .direct { margin: 40px 0 14px; font-size: 14px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; }
  .direct-links { display: flex; flex-wrap: wrap; gap: 12px; }
</style>
