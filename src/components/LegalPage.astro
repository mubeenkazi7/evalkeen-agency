---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
interface Props { title: string; description: string }
const { title, description } = Astro.props;
---
<Base title={`${title} | evalkeen`} description={description} current="legal">
  <article class="container legal">
    <header class="legal-head">
      <p class="eyebrow">Legal</p>
      <h1 class="h1 legal-title">{title}</h1>
      <p class="muted">Effective {site.legal.effectiveDate}</p>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  .legal { padding-block: clamp(48px, 7vw, 104px); }
  .legal-head { border-bottom: 2px solid var(--rule); padding-bottom: 32px; margin-bottom: 40px; max-width: 760px; }
  .legal-title { font-size: clamp(40px, 5.5vw, 72px); margin-bottom: 16px; }
  .prose { max-width: 760px; }
  .prose :global(h2) { font-family: var(--display); font-weight: 800; font-size: 26px; letter-spacing: -0.02em; line-height: 1.2; margin: 48px 0 14px; }
  .prose :global(h3) { font-family: var(--display); font-weight: 700; font-size: 19px; margin: 28px 0 10px; }
  .prose :global(p) { margin: 0 0 16px; color: var(--body-dark); }
  .prose :global(ul) { margin: 0 0 16px; padding-left: 22px; list-style: disc; color: var(--body-dark); }
  .prose :global(li) { margin-bottom: 8px; }
  .prose :global(a) { color: var(--red-strong); }
  .prose :global(.box) { background: var(--panel); padding: 20px 24px; margin: 0 0 16px; }
  .prose :global(.box p:last-child) { margin-bottom: 0; }
</style>
