---
// Demo video from a YouTube or Loom link (or an .mp4 path).
// Nothing from YouTube/Loom loads until the visitor presses play: we show a lightweight
// placeholder first and swap in the real player on click.
// With no url set in site.config.ts, it shows a "coming soon" frame.
import { toEmbed } from '../lib/video';

interface Props { url: string; vertical?: boolean; poster?: string; label: string; caption?: string; dark?: boolean }
const { url, vertical = true, poster, label, caption, dark = false } = Astro.props;
const v = toEmbed(url);
const thumb = poster || (v?.kind === 'youtube' && !vertical ? `https://i.ytimg.com/vi/${v.id}/hqdefault.jpg` : '');
---
<figure class:list={['demo', vertical ? 'vertical' : 'landscape', { dark }]}>
  <div class="frame">
    {v?.kind === 'mp4' ? (
      <video controls playsinline preload="none" poster={thumb || undefined} aria-label={label}>
        <source src={v.src} type="video/mp4" />
      </video>
    ) : v ? (
      <button type="button" class="screen" data-embed={v.src} data-kind={v.kind} data-title={label} aria-label={`Play ${label}`}>
        {thumb && <img src={thumb} alt="" loading="lazy" />}
        <span class="play" aria-hidden="true"><svg width="30" height="30" viewBox="0 0 24 24" fill="#fff"><path d="M7 4l13 8-13 8z" /></svg></span>
      </button>
    ) : (
      <div class="screen" role="img" aria-label={`${label} (coming soon)`}>
        <span class="play" aria-hidden="true"><svg width="30" height="30" viewBox="0 0 24 24" fill="#fff"><path d="M7 4l13 8-13 8z" /></svg></span>
        <span class="soon">Demo video coming soon</span>
      </div>
    )}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .demo { margin: 0 auto; width: 100%; }
  .vertical { max-width: 380px; }
  .landscape { max-width: 720px; }
  .vertical .frame { background: #0b0b0b; padding: 10px; border-radius: 40px; }
  .landscape .frame { background: #0b0b0b; padding: 8px; border-radius: 16px; }
  .frame video, .frame :global(iframe) { display: block; }
  .frame > *, .frame :global(iframe) { width: 100%; border: 0; background: #2a2926; object-fit: cover; }
  .vertical .frame > *, .vertical .frame :global(iframe) { aspect-ratio: 9 / 16; border-radius: 30px; }
  .landscape .frame > *, .landscape .frame :global(iframe) { aspect-ratio: 16 / 9; border-radius: 10px; }
  .frame .screen { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 18px; padding: 0; font: inherit; overflow: hidden; }
  button.screen { cursor: pointer; }
  .screen img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .play { position: relative; width: 88px; height: 88px; border-radius: 50%; background: var(--red); display: flex; align-items: center; justify-content: center; transition: transform 0.15s; }
  button.screen:hover .play { transform: scale(1.06); }
  .soon { font-size: 14px; color: var(--hairline); }
  figcaption { margin-top: 18px; text-align: center; font-weight: 600; font-size: 16px; }
  .dark figcaption { color: var(--bg); }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('button[data-embed]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = btn.dataset.embed!;
      iframe.title = btn.dataset.title || 'Demo video';
      iframe.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
      iframe.allowFullscreen = true;
      if (btn.dataset.kind === 'youtube') {
        // YouTube resumes where a signed-in viewer last stopped. If playback starts
        // past the beginning, jump back to 0:00 once.
        let done = false;
        const send = (msg: object) => iframe.contentWindow?.postMessage(JSON.stringify(msg), '*');
        const onMsg = (e: MessageEvent) => {
          if (e.source !== iframe.contentWindow || done) return;
          let data: any;
          try { data = typeof e.data === 'string' ? JSON.parse(e.data) : e.data; } catch { return; }
          const t = data?.info?.currentTime;
          if (typeof t === 'number' && t > 0) {
            done = true;
            window.removeEventListener('message', onMsg);
            if (t > 1.5) send({ event: 'command', func: 'seekTo', args: [0, true] });
          }
        };
        window.addEventListener('message', onMsg);
        iframe.addEventListener('load', () => send({ event: 'listening', id: 1 }));
      }
      btn.replaceWith(iframe);
      iframe.focus();
    });
  });
</script>
